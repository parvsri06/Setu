# ============================================================
# SETU RELIEF REGISTRY BACKEND — ENVIRONMENT TEMPLATE
# Copy to `.env` (which is gitignored) and fill in real values.
# NEVER commit a real `.env` or real Neon credentials.
# ============================================================

# --- Database ---
# Local dev default (SQLite, zero setup). Leave as-is to run with no DB.
DATABASE_URL=sqlite:///./relief_registry.db

# Production: Neon PostgreSQL connection string from the DB teammate.
# Example shape (DO NOT use the real one from db/.env.example — that file
# contains live credentials; keep those out of version control):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/Setu?sslmode=require

# --- Auth (Phase 6) ---
# JWT signing secret — set to a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=3600

# Shared dev key to gate export/admin endpoints ("admins = us").
# Pass as the X-Dev-Key header, or exchange it at POST /api/v1/auth/login for a JWT.
DEV_API_KEY=change-me-dev-key

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=True
